#. module: partner_identification
msgid ""
"# Use failed = True to specify that the id number is not valid.\n"
"# You can use the following variables :\n"
"#  - self: browse_record of the current ID Category browse_record\n"
"#  - id_number: browse_record of ID number to validate\n"
"\n"
"<b>\n"
"                                    <i># Sample 1: ID number only contains "
"digits</i>\n"
"                                </b>\n"
"if not id_number.name.isdigit():\n"
"    failed = True\n"
"else:\n"
"    failed = False\n"
"\n"
"<b>\n"
"                                    <i># Sample 2: Length of ID number "
"cannot exceed 10 chars</i>\n"
"                                </b>\n"
"failed = len(id_number.name) &gt; 10 and True or False\n"
"\n"
"<b>\n"
"                                    <i># Sample 3: ID number must start with"
" the category code</i>\n"
"                                </b>\n"
"failed = not id_number.name.startswith(self.code) and True or False"
msgstr ""
"# Використовуйте failed = True, щоб указати, що ідентифікаційний номер "
"недійсний.\n"
"# Можна використовувати такі змінні:\n"
"#  - self: browse_record поточної категорії ID\n"
"#  - id_number: browse_record ідентифікаційного номера для перевірки\n"
"\n"
"<b>\n"
"                                    <i># Приклад 1: ідентифікаційний номер "
"містить лише цифри</i>\n"
"                                </b>\n"
"if not id_number.name.isdigit():\n"
"    failed = True\n"
"else:\n"
"    failed = False\n"
"\n"
"<b>\n"
"                                    <i># Приклад 2: довжина "
"ідентифікаційного номера не може перевищувати 10 символів</i>\n"
"                                </b>\n"
"failed = len(id_number.name) &gt; 10 and True or False\n"
"\n"
"<b>\n"
"                                    <i># Приклад 3: ідентифікаційний номер "
"має починатися з коду категорії</i>\n"
"                                </b>\n"
"failed = not id_number.name.startswith(self.code) and True or False"

